# AI Truth Inspector Environment Variables
# Copy this file to backend/.env and set your values

# LLM Provider Configuration ("gemini" or "anthropic")
# Default: gemini (Free tier available at https://aistudio.google.com/app/apikey)
LLM_PROVIDER=gemini

# Google Gemini API Key
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=

# Default Gemini Model options:
# - gemini-1.5-flash (fast, high rate limits, highly cost-effective)
# - gemini-2.0-flash (next-gen, low latency)
# - gemini-1.5-pro (deep reasoning)
LLM_MODEL=gemini-1.5-flash

# Optional: Anthropic Provider (if using LLM_PROVIDER=anthropic)
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Local Embedding Configuration (Runs locally via sentence-transformers, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage and Directories
UPLOAD_DIR=data/uploads
CHROMA_DIR=data/chroma
DATABASE_URL=sqlite:///./data/truth_inspector.db

# Ingestion settings
MAX_UPLOAD_SIZE_MB=20
DEFAULT_CHUNK_SIZE_CHARS=800
DEFAULT_CHUNK_OVERLAP_CHARS=150

# Server Configuration
HOST=127.0.0.1
PORT=8000
FRONTEND_PORT=5173
ENVIRONMENT=development
